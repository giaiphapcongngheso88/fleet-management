rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'ADMIN';
    }

    // Vai trò được phép quản lý danh mục / báo giá (Admin, Quản lý, Điều hành).
    function canManageMasterData() {
      return isSignedIn() && myRole() in ['ADMIN', 'QUAN_LY', 'DIEU_HANH'];
    }

    // Vai trò được phép tạo/sửa Thu - Chi (Admin, Quản lý, Kế toán) — đúng resource "finance"
    // trong src/utils/permissions.ts (Điều hành KHÔNG có quyền tài chính).
    function canManageFinance() {
      return isSignedIn() && myRole() in ['ADMIN', 'QUAN_LY', 'KE_TOAN'];
    }

    function isActiveUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    // ---- users: hồ sơ người dùng ----
    match /users/{userId} {
      allow read: if isSignedIn();
      // Tạo hồ sơ của chính mình khi đăng nhập lần đầu, mặc định vai trò thấp nhất, KHÔNG được tự gán ADMIN.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role in ['STAFF'];
      // Tự sửa thông tin cá nhân (không đổi role/status); Admin sửa được mọi thứ (đổi role, khóa tài khoản).
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if false;
    }

    // ---- Danh mục dùng chung ----
    match /customers/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /vendors/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /vehicles/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /drivers/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /locations/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /products/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /price_lists/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    match /cost_types/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    // Chuyến xe / nhật trình (mục 5 đặc tả nghiệp vụ) — cùng nhóm vai trò được tạo/sửa chuyến
    // (ADMIN/QUAN_LY/DIEU_HANH) như trong src/utils/permissions.ts.
    match /trips/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    // Bộ đếm sinh mã chứng từ tuần tự (mục 43), ví dụ TRIP-202609-00001.
    // Cho phép cả canManageFinance() ghi vì Kế toán cũng cần sinh mã PT-/PC- khi tạo phiếu thu/chi.
    match /number_sequences/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData() || canManageFinance();
    }

    // Thu - Chi (mục 18 đặc tả nghiệp vụ).
    match /finance_transactions/{id} {
      allow read: if isActiveUser();
      allow write: if canManageFinance();
    }

    // Lương tài xế theo kỳ (mục 25-27) — cùng nhóm vai trò với Thu - Chi (ADMIN/QUAN_LY/KE_TOAN);
    // phân biệt CREATE/UPDATE (Kế toán) và LOCK/UNLOCK (Quản lý) ở tầng ứng dụng (src/utils/permissions.ts).
    match /payroll_periods/{id} {
      allow read: if isActiveUser();
      allow write: if canManageFinance();
    }

    // Báo giá (mục 28 đặc tả nghiệp vụ) — cùng nhóm vai trò được tạo/sửa như Chuyến xe
    // (ADMIN/QUAN_LY/DIEU_HANH), KHÔNG gồm Kế toán (đúng resource "quote" trong permissions.ts).
    match /quotes/{id} {
      allow read: if isActiveUser();
      allow write: if canManageMasterData();
    }

    // Phân quyền động (mục 38) — mọi user đã đăng nhập cần đọc để PermissionContext tính can() đúng
    // ngay khi tải trang; chỉ Admin được ghi (đổi qua màn hình Phân quyền — src/utils/permissions.ts
    // luôn cấm ghi đè vai trò ADMIN dù rules có cho phép, an toàn 2 lớp).
    match /role_permissions/{roleId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Thông tin công ty dùng cho letterhead/chữ ký khi xuất Excel (mục 35) — mọi user đã đăng nhập
    // cần đọc để xuất Excel đúng thông tin mới nhất; chỉ Admin được sửa qua trang Thông tin công ty.
    match /settings/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Mặc định: chặn tất cả các collection chưa được khai báo tường minh ở trên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
